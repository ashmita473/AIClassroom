@model AIClassroom.Models.LiveClass
@{ViewData["Title"]="Live Classroom";var room=$"{Model.GroupName}-{Model.ClassNumber}";}
<div class="live-head" data-live-room data-room="@room"><div><div class="eyebrow">📡 LIVE CLASS · @Model.GroupName · CLASS @Model.ClassNumber</div><h1>@Model.CurriculumDay!.Title</h1><span class="live-pill">● LIVE</span></div><div class="robot-big">🤖</div></div><div class="live-grid"><section class="live-stage pixel"><div id="liveStatus">Waiting for teacher action…</div><div id="activityArea"><h2>🎓 @Model.CurriculumDay.Title</h2><p>@Model.CurriculumDay.ContentSummary</p></div><div class="live-controls">@if(User.IsInRole("SuperAdmin")||User.IsInRole("Teacher")){<button type="button" data-command="previous" class="small-btn">← Previous</button><button type="button" data-command="next" class="small-btn primary">Next →</button><button type="button" data-command="quiz" class="small-btn">🧪 Quiz</button><button type="button" data-command="game" class="small-btn">🎮 Game</button>}else{<span class="pill">👩‍🏫 Follow your teacher's screen</span>}</div></section><aside class="panel pixel"><h2>📡 Connection</h2><p id="connection">Connecting…</p><p class="hint">Room: @room</p>@if(User.IsInRole("SuperAdmin")||User.IsInRole("Teacher")){<form method="post" asp-action="End"><input type="hidden" name="id" value="@Model.Id"/><button class="danger-btn">End Live Class</button></form>}</aside></div>
<script src="~/lib/microsoft-signalr/signalr.min.js" asp-append-version="true"></script><script src="~/js/live-room.js" asp-append-version="true"></script>
