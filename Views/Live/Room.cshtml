@model AIClassroom.Models.LiveClass
@{ViewData["Title"]="Live Classroom";var room=$"{Model.GroupName}-{Model.ClassNumber}";}
<div class="live-head"><div><div class="eyebrow">📡 LIVE CLASS · @Model.GroupName · CLASS @Model.ClassNumber</div><h1>@Model.CurriculumDay!.Title</h1><span class="live-pill">● LIVE</span></div><div class="robot-big">🤖</div></div><div class="live-grid"><section class="live-stage pixel"><div id="liveStatus">Waiting for teacher action…</div><div id="activityArea"><h2>🎓 @Model.CurriculumDay.Title</h2><p>@Model.CurriculumDay.ContentSummary</p></div><div class="live-controls">@if(User.IsInRole("SuperAdmin")||User.IsInRole("Teacher")){<button type="button" data-command="previous" class="small-btn">← Previous</button><button type="button" data-command="next" class="small-btn primary">Next →</button><button type="button" data-command="quiz" class="small-btn">🧪 Quiz</button><button type="button" data-command="game" class="small-btn">🎮 Game</button>}else{<span class="pill">👩‍🏫 Follow your teacher's screen</span>}</div></section><aside class="panel pixel"><h2>📡 Connection</h2><p id="connection">Connecting…</p><p class="hint">Room: @room</p>@if(User.IsInRole("SuperAdmin")||User.IsInRole("Teacher")){<form method="post" asp-action="End"><input type="hidden" name="id" value="@Model.Id"/><button class="danger-btn">End Live Class</button></form>}</aside></div>
@section Scripts{<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script><script>const room=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(room));const hub=new signalR.HubConnectionBuilder().withUrl('/classroomHub').build();hub.on('TeacherCommand',(cmd)=>{document.getElementById('liveStatus').textContent='Teacher command: '+cmd.toUpperCase();});hub.on('TeacherAnnouncement',(msg)=>{const h=document.createElement('h2');h.textContent='📢 '+msg;const area=document.getElementById('activityArea');area.replaceChildren(h);});hub.start().then(()=>hub.invoke('JoinClass',room).then(()=>document.getElementById('connection').textContent='Connected to classroom.')).catch(()=>document.getElementById('connection').textContent='Connection failed. Check the school network.');document.querySelectorAll('[data-command]').forEach(b=>b.addEventListener('click',()=>hub.invoke('TeacherCommand',room,b.dataset.command)));</script>}
