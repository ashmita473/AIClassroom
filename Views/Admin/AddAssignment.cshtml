@model AIClassroom.Models.Assignment
@{ViewData["Title"]="Add Assignment";}<div class="form-card pixel"><div class="eyebrow">CLASSROOM TASKS</div><h1>📚 Create Assignment</h1><form method="post"><label>Title<input asp-for="Title" required/></label><label>Instructions<textarea asp-for="Instructions" rows="8" required></textarea></label><div class="form-grid"><label>Group<select asp-for="GroupName"><option>A</option><option>B</option><option>All</option></select></label><label>Due date<input asp-for="DueDateUtc" type="datetime-local"/></label><label>XP<input asp-for="XpReward" type="number" min="0"/></label></div><label class="check"><input asp-for="IsPublished"/> Publish now</label><button class="big-btn primary">💾 Save Assignment</button></form></div>
