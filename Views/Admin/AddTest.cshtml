@model AIClassroom.Models.Test
@{ViewData["Title"]="Add Test";}
<div class="form-card pixel"><div class="eyebrow">ASSESSMENT LAB</div><h1>Create Test</h1><form method="post"><label>Title<input asp-for="Title" required/></label><div class="form-grid"><label>Group<select asp-for="GroupName"><option>A</option><option>B</option><option>All</option></select></label><label>Test type<select asp-for="TestType"><option>Unit</option><option>Module</option><option>Revision</option><option>Final</option></select></label><label>Time limit<input asp-for="TimeLimitMinutes" type="number" min="1"/></label><label>Passing score<input asp-for="PassingScore" type="number" min="0" max="100"/></label></div><label class="check"><input asp-for="RandomizeQuestions"/> Randomize questions</label><label class="check"><input asp-for="IsPublished"/> Publish now</label><button class="big-btn primary">Save Test & Add Questions</button></form></div>
