@model List<AIClassroom.Models.CurriculumDay>
@{ViewData["Title"]="Live Classroom";}<div class="page-title"><div><div class="eyebrow">SIGNALR CLASSROOM</div><h1>📡 Start Live Class</h1><p class="muted">Choose a group, class and published day. Student screens can follow the teacher in real time.</p></div></div><div class="form-card pixel"><form method="post" asp-controller="Live" asp-action="Start"><div class="form-grid"><label>Group<select name="group"><option>A</option><option>B</option></select></label><label>Class<select name="classNumber">@for(int c=3;c<=8;c++){<option>@c</option>}</select></label><label>Lesson<select name="dayId">@foreach(var d in Model){<option value="@d.Id">Day @d.DayNumber — @d.Title</option>}</select></label></div><button class="big-btn primary">🟢 START LIVE CLASS</button></form></div>
