@model List<AIClassroom.Models.CurriculumModule>
@{ViewData["Title"]="Curriculum";}
<div class="page-title"><div><div class="eyebrow">CURRICULUM ENGINE</div><h1>📚 Curriculum</h1></div><div><a class="small-btn @(ViewBag.Group=="A"?"primary":"")" asp-action="Curriculum" asp-route-group="A">Group A</a><a class="small-btn @(ViewBag.Group=="B"?"primary":"")" asp-action="Curriculum" asp-route-group="B">Group B</a></div></div>
@foreach(var m in Model){<section class="module pixel"><div class="module-head"><div><span class="pill">@m.Code · Group @m.GroupName · Class @m.ClassMin–@m.ClassMax</span><h2>@m.Title</h2></div><span>@m.Days.Count days</span></div><div class="day-grid">@foreach(var d in m.Days.OrderBy(x=>x.DayNumber)){<div class="day-card @(d.IsLocked?"locked":"open")"><div><b>DAY @d.DayNumber</b><h3>@d.Title</h3><p>@d.ContentSummary</p></div><form method="post" asp-action="ToggleDay" asp-route-id="@d.Id"><button class="small-btn">@(d.IsLocked?"🔒 Unlock":"🟢 Lock")</button></form></div>}</div></section>}
