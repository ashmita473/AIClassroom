@model AIClassroom.Models.Student
@{ViewData["Title"]="Add Student";}
<div class="form-card pixel"><div class="eyebrow">SCHOOL MANAGEMENT</div><h1>👨‍🎓 Add Student</h1><form method="post"><div asp-validation-summary="ModelOnly" style="color:#ff6b6b;font-weight:bold;margin:8px 0"></div><label>Name<input asp-for="Name" required/></label><label>Roll Number<input asp-for="RollNumber" required/></label><div class="form-grid"><label>Group<select asp-for="GroupName"><option>A</option><option>B</option></select></label><label>Class<select asp-for="ClassNumber">@for(int c=3;c<=8;c++){<option value="@c">@c</option>}</select></label></div><label>PIN<input name="Pin" inputmode="numeric" pattern="[0-9]{4,8}" minlength="4" maxlength="8" placeholder="4-8 digits" autocomplete="off" required/></label><label>Avatar<input asp-for="Avatar" value="🤖"/></label><button class="big-btn primary">💾 Create Student</button></form></div>
