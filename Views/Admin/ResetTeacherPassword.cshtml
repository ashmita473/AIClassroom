@model AIClassroom.Models.ResetTeacherPasswordViewModel
@{ ViewData["Title"] = "Reset Teacher Password"; }
<div class="form-card pixel">
    <div class="eyebrow">TEACHER SECURITY</div>
    <h1>Reset Password</h1>
    <p><strong>@Model.TeacherName</strong> · @Model.Username</p>
    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="TeacherId" />
        <label>New password<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="10" required /></label>
        <label>Confirm password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" required /></label>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <button class="small-btn primary" type="submit">Reset Password</button>
        <a class="small-btn" asp-action="Teachers">Cancel</a>
    </form>
</div>
