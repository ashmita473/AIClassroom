@model AIClassroom.Models.CurriculumDayEditViewModel
@{ViewData["Title"]="Lesson Settings";}
<div class="curriculum-editor-page"><div class="editor-shell"><div class="eyebrow">LESSON SETTINGS</div><h1>Edit lesson settings</h1><p class="editor-subtitle">Control the lesson title, summary, XP and student visibility.</p><form method="post" class="editor-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CurriculumModuleId" /><div class="editor-grid-2"><label>Lesson number<input asp-for="DayNumber" type="number" min="1" /></label><label>XP reward<input asp-for="XpReward" type="number" min="0" max="10000" /></label></div><label>Lesson title<input asp-for="Title" maxlength="200" /></label><label>Short summary<textarea asp-for="ContentSummary" rows="3"></textarea></label><div class="toggle-row"><label><input asp-for="IsPublished" /> Published</label><label><input asp-for="IsLocked" /> Locked</label></div><div class="editor-actions"><a class="small-btn" asp-action="Curriculum">Cancel</a><a class="small-btn" asp-action="EditLesson" asp-route-dayId="@Model.Id">Open rich editor</a><button class="big-btn primary" type="submit">Save settings →</button></div></form></div></div>
