@model List<AIClassroom.Models.Assignment>
@{ViewData["Title"]="Assignments";}<div class="page-title"><div><div class="eyebrow">CLASSROOM TASKS</div><h1>📚 Assignments</h1></div><a class="big-btn primary" asp-action="AddAssignment">+ Add Assignment</a></div><div class="quiz-list">@foreach(var a in Model){<article class="panel pixel"><span class="pill">@a.GroupName</span><h2>@a.Title</h2><p>@a.Instructions</p><small>+@a.XpReward XP · @(a.IsPublished?"Published":"Draft")</small></article>}</div>
