@model List<AIClassroom.Models.Student>
@{ViewData["Title"]="Students";}
<div class="page-title"><div><div class="eyebrow">SCHOOL MANAGEMENT</div><h1>👨‍🎓 Students</h1></div><a class="big-btn primary" asp-action="AddStudent">+ Add Student</a></div>
<form class="filter-bar pixel" method="get"><input name="q" value="@ViewBag.Q" placeholder="Search name or roll..."/><select name="group"><option value="">All groups</option><option selected="@(ViewBag.Group=="A")">A</option><option selected="@(ViewBag.Group=="B")">B</option></select><select name="classNumber"><option value="">All classes</option>@for(int c=3;c<=8;c++){<option value="@c" selected="@(ViewBag.ClassNumber==c)">Class @c</option>}</select><button class="small-btn primary">Filter</button></form>
<div class="table-wrap pixel"><table><thead><tr><th>Student</th><th>Group</th><th>Class</th><th>Roll</th><th>XP</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Avatar @s.Name</td><td>@s.GroupName</td><td>@s.ClassNumber</td><td>@s.RollNumber</td><td>⭐ @s.TotalXp</td><td><span class="pill">@(s.IsActive?"Active":"Disabled")</span></td><td><form method="post" asp-action="ToggleStudent"><input type="hidden" name="id" value="@s.Id"/><button class="small-btn">@(s.IsActive?"Disable":"Enable")</button></form></td></tr>}</tbody></table></div>
