@model List<AIClassroom.Models.Announcement>
@{ViewData["Title"]="Announcements";}<div class="page-title"><div><div class="eyebrow">CLASSROOM MESSAGES</div><h1>📢 Announcements</h1></div></div><div class="form-card pixel"><form method="post"><div class="form-grid"><label>Title<input name="title" required/></label><label>Group<select name="groupName"><option value="">All groups</option><option>A</option><option>B</option></select></label></div><label>Message<textarea name="message" rows="4" required></textarea></label><button class="big-btn primary">📢 Publish Announcement</button></form></div><div class="note-grid">@foreach(var a in Model){<article class="note pixel"><span class="pill">@(a.GroupName ?? "ALL")</span><h2>@a.Title</h2><p>@a.Message</p></article>}</div>
