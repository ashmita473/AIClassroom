@model List<AIClassroom.Models.Question>
@{ViewData["Title"]="Question Bank"; var quizzes=ViewBag.Quizzes as List<AIClassroom.Models.Quiz> ?? new(); var tests=ViewBag.Tests as List<AIClassroom.Models.Test> ?? new();}
<div class="page-title"><div><div class="eyebrow">QUESTION BANK</div><h1>All Questions</h1><p class="muted">Create once, reuse across quizzes and tests.</p></div></div>
<form class="filter-bar pixel" method="get"><input name="topic" value="@ViewBag.Topic" placeholder="Filter by topic"/><select name="type"><option value="">All types</option>@foreach(var x in new[]{"MCQ","TrueFalse","Image","Match","Ordering","Scenario","ShortAnswer"}){<option value="@x" selected="@(ViewBag.Type==x ? "selected" : null)">@x</option>}</select><button class="big-btn primary">Filter</button></form>
<div class="question-list">
@foreach(var q in Model){<article class="bank-row"><div><small>@q.QuestionType · @q.Topic · @q.Difficulty · @q.Points pts</small><p>@q.Prompt</p></div><div class="assess-actions"><form method="post" asp-action="UseQuestion"><input type="hidden" name="id" value="@q.Id"/><input type="hidden" name="parentType" value="Quiz"/><select name="parentId" required>@foreach(var quiz in quizzes){<option value="@quiz.Id">@quiz.Title</option>}</select><button class="assess-btn secondary">Copy to Quiz</button></form><form method="post" asp-action="UseQuestion"><input type="hidden" name="id" value="@q.Id"/><input type="hidden" name="parentType" value="Test"/><select name="parentId" required>@foreach(var test in tests){<option value="@test.Id">@test.Title</option>}</select><button class="assess-btn secondary">Copy to Test</button></form></div></article>}
</div>
