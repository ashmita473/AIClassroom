@model AIClassroom.Models.AdminDashboardViewModel
@{ViewData["Title"]="Teacher Dashboard";}
<div class="dashboard-head"><div><div class="eyebrow">TEACHER CONTROL CENTER</div><h1>AI Classroom <span>🧑‍🏫</span></h1><p class="muted">Control lessons, students, games and live classroom missions.</p></div><div class="robot-card pixel"><span class="avatar">🤖</span><b>CONTROL MODE</b><small>Everything in one place</small></div></div>
<div class="stat-grid"><div class="stat"><b>👨‍🎓 @Model.Students</b><span>Students</span></div><div class="stat"><b>👩‍🏫 @Model.Teachers</b><span>Teachers</span></div><div class="stat"><b>📚 @Model.PublishedLessons</b><span>Published days</span></div><div class="stat"><b>🎮 @Model.Games</b><span>Games</span></div><div class="stat"><b>🧪 @Model.Quizzes</b><span>Quizzes</span></div><div class="stat"><b>📝 @Model.Submissions</b><span>Submissions</span></div></div>
<div class="admin-grid"><a class="admin-tile pixel" asp-action="Students"><span>👨‍🎓</span><h2>Students</h2><p>Add, search, filter and activate/deactivate students.</p></a><a class="admin-tile pixel" asp-action="Curriculum"><span>📚</span><h2>Curriculum</h2><p>View Group A/B days and unlock or lock content.</p></a><a class="admin-tile pixel" asp-action="Games"><span>🎮</span><h2>Games</h2><p>Manage the learning arcade.</p></a><a class="admin-tile pixel" asp-action="Quizzes"><span>🧪</span><h2>Quizzes</h2><p>Create and publish quiz shells.</p></a><a class="admin-tile pixel" asp-action="Assignments"><span>📋</span><h2>Assignments</h2><p>Create tasks and track submissions.</p></a><a class="admin-tile pixel" asp-action="Analytics"><span>📈</span><h2>Analytics</h2><p>See class performance and participation.</p></a><a class="admin-tile pixel" asp-action="Live"><span>📡</span><h2>Live Classroom</h2><p>Start a synchronized classroom mission.</p></a><a class="admin-tile pixel" asp-action="Announcements"><span>📢</span><h2>Announcements</h2><p>Send messages to students.</p></a></div>
