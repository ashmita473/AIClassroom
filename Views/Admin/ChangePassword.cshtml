@model AIClassroom.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Change Password"; }
<div class="form-card pixel">
    <div class="eyebrow">ACCOUNT SECURITY</div>
    <h1>Change My Password</h1>
    <p>Use a strong password of at least 10 characters.</p>
    <form method="post">
        @Html.AntiForgeryToken()
        <label>Current password<input asp-for="CurrentPassword" type="password" autocomplete="current-password" required /></label>
        <label>New password<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="10" required /></label>
        <label>Confirm new password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="10" required /></label>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <button class="small-btn primary" type="submit">Change Password</button>
    </form>
</div>
