@model AIClassroom.Models.Game
@{ViewData["Title"]="Add Game";}<div class="form-card pixel"><div class="eyebrow">LEARNING ARCADE</div><h1>🎮 Add Game</h1><form method="post"><label>Name<input asp-for="Name" required/></label><div class="form-grid"><label>Group<select asp-for="GroupName"><option>A</option><option>B</option><option>All</option></select></label><label>Game Type<input asp-for="GameType" placeholder="pattern / maze / prompt" required/></label></div><label>Description<textarea asp-for="Description" rows="4"></textarea></label><label>Base XP<input asp-for="BaseXp" type="number" min="0"/></label><button class="big-btn primary">💾 Save Game</button></form></div>
