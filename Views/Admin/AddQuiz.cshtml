@model AIClassroom.Models.Quiz
@{ViewData["Title"]="Add Quiz";}
<div class="form-card pixel"><div class="eyebrow">KNOWLEDGE LAB</div><h1>Create Quiz</h1><form method="post"><label>Title<input asp-for="Title" required/></label><div class="form-grid"><label>Group<select asp-for="GroupName"><option>A</option><option>B</option><option>All</option></select></label><label>Time limit (minutes)<input asp-for="TimeLimitMinutes" type="number" min="1"/></label><label>Passing score<input asp-for="PassingScore" type="number" min="0" max="100"/></label><label>Max attempts<input asp-for="MaxAttempts" type="number" min="1"/></label></div><label class="check"><input asp-for="RandomizeQuestions"/> Randomize questions for every attempt</label><label class="check"><input asp-for="ShowInstantResults"/> Show instant result after submission</label><label class="check"><input asp-for="IsPublished"/> Publish now</label><button class="big-btn primary">Save Quiz & Add Questions</button></form></div>
