@model List<AIClassroom.Models.Student>
@{ViewData["Title"]="Analytics";}<div class="page-title"><div><div class="eyebrow">CLASS PERFORMANCE</div><h1>📈 Analytics</h1></div></div><div class="stat-grid"><div class="stat"><b>⭐ @ViewBag.AvgXp</b><span>Average XP</span></div><div class="stat"><b>🎯 @ViewBag.AvgQuiz%</b><span>Average quiz</span></div><div class="stat"><b>📚 @ViewBag.Completed</b><span>Completed lessons</span></div><div class="stat"><b>🎮 @ViewBag.GamePlays</b><span>Game plays</span></div></div><div class="table-wrap pixel"><table><thead><tr><th>Student</th><th>Group</th><th>Class</th><th>XP</th><th>Last active</th></tr></thead><tbody>@foreach(var s in Model.OrderByDescending(x=>x.TotalXp)){<tr><td>@s.Avatar @s.Name</td><td>@s.GroupName</td><td>@s.ClassNumber</td><td>⭐ @s.TotalXp</td><td>@(s.LastActiveUtc?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—")</td></tr>}</tbody></table></div>
