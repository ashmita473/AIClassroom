@model AIClassroom.Models.CurriculumDayEditViewModel
@{ViewData["Title"]="Add Lesson";}
<div class="curriculum-editor-page"><div class="editor-shell"><div class="eyebrow">NEW LESSON</div><h1>Add lesson</h1><p class="editor-subtitle">Create the lesson shell first. Then open the rich lesson editor to build the full content.</p><form method="post" class="editor-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="CurriculumModuleId" /><div class="editor-grid-2"><label>Lesson number<input asp-for="DayNumber" type="number" min="1" /></label><label>XP reward<input asp-for="XpReward" type="number" min="0" max="10000" /></label></div><label>Lesson title<input asp-for="Title" maxlength="200" placeholder="Intelligence & AI Introduction" /></label><label>Short summary<textarea asp-for="ContentSummary" rows="3" placeholder="What students will learn in this lesson..."></textarea></label><div class="toggle-row"><label><input asp-for="IsPublished" /> Publish for students</label><label><input asp-for="IsLocked" /> Keep locked</label></div><div class="editor-actions"><a class="small-btn" asp-action="Curriculum">Cancel</a><button class="big-btn primary" type="submit">Create lesson →</button></div></form></div></div>
