@model AIClassroom.Models.NoteEditViewModel
@{ViewData["Title"]="New Note";}<div class="form-card pixel"><div class="eyebrow">STUDENT NOTES</div><h1>📝 Create a note</h1><form method="post"><input type="hidden" asp-for="CurriculumDayId"/><label>Title<input asp-for="Title" required placeholder="e.g. What I learned about AI"/></label><label>Notes<textarea asp-for="Content" rows="10" required placeholder="Write in your own words..."></textarea></label><label class="check"><input asp-for="IsPinned"/> Pin this note</label><button class="big-btn primary">💾 Save Note</button></form></div>
