@model AIClassroom.Models.Student
@{ViewData["Title"]="Scorecard"; var accuracy=(double)(ViewBag.Accuracy??0);}
<div class="assess-shell scorecard-page">
 <div class="assess-wrap">
  <header class="assess-top"><a class="assess-brand" asp-controller="Student" asp-action="Index"><span class="brand-ai">AI</span> CLASSROOM</a><nav class="assess-nav"><a asp-controller="Student" asp-action="Index"><img src="~/images/ui/home.svg" alt="">Home</a><a asp-controller="Curriculum" asp-action="Index"><img src="~/images/ui/book.svg" alt="">Learn</a><a asp-controller="Student" asp-action="Games"><img src="~/images/ui/game.svg" alt="">Games</a><a asp-controller="Student" asp-action="Quizzes"><img src="~/images/ui/quiz.svg" alt="">Quizzes</a><a asp-controller="Test" asp-action="Index" class="active"><img src="~/images/home/tests.png" alt="">Tests</a></nav><div class="assess-user"><img src="~/images/character/base-boy-reference-proportions.png" alt=""> <span>@Model.Name</span><span>⌄</span></div></header>
  <div class="score-breadcrumb"><a asp-controller="Student" asp-action="Index">← Home</a><span>›</span><a asp-controller="Student" asp-action="Quizzes">Quizzes</a><span>›</span><a asp-controller="Test" asp-action="Index">Tests</a><span>›</span><b>Scorecard</b></div>
  <section class="score-hero"><div><div class="assess-eyebrow">PERSONAL SCORECARD</div><h1>@Model.Name</h1><p>Class @Model.ClassNumber · Group @Model.GroupName · Roll @Model.RollNumber</p></div><img src="~/images/quiz-ui/quiz-hero-robot.png" alt="Student scorecard robot"></section>
  <div class="result-stats score-stats"><div class="result-stat"><span class="stat-icon gold">★</span><b>@Model.TotalXp</b><span>XP</span></div><div class="result-stat"><span class="stat-icon purple">▥</span><b>@ViewBag.LessonsCompleted/@ViewBag.TotalLessons</b><span>Lessons</span></div><div class="result-stat"><span class="stat-icon green">⌁</span><b>@ViewBag.Games</b><span>Games</span></div><div class="result-stat"><span class="stat-icon pink">▤</span><b>@ViewBag.Tests</b><span>Tests</span></div><div class="result-stat"><span class="stat-icon orange">◎</span><b>@accuracy%</b><span>Accuracy</span></div></div>
  <section class="assess-card topic-card score-topic"><h2>Topic Performance</h2><div class="topic-grid">@foreach(var x in ViewBag.TopicPerformance){<div class="topic-row"><header><strong>@x.Topic</strong><b>@x.Accuracy%</b></header><div class="topic-bar"><i style="width:@x.Accuracy%"></i></div></div>}</div></section>
  <div class="area-grid"><div class="area-box strong"><span class="area-icon">▥</span><div><h3>Strong Areas</h3><ul>@foreach(var x in ViewBag.TopicPerformance){if(x.Accuracy>=80){<li>@x.Topic — @x.Accuracy%</li>}}</ul></div></div><div class="area-box revision"><span class="area-icon">◎</span><div><h3>Needs Revision</h3><ul>@foreach(var x in ViewBag.TopicPerformance){if(x.Accuracy<70){<li>@x.Topic — @x.Accuracy%</li>}}</ul></div></div></div>
  <section class="assess-card xp-card"><h2>◷ XP History</h2>@foreach(var x in ViewBag.XpHistory){<div class="xp-row"><span>@(x.Points>=0?"+":"")@x.Points</span><p>@x.Reason</p><b>›</b></div>}</section>
 </div>
</div>
