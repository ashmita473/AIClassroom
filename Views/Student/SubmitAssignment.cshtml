@model AIClassroom.Models.AssignmentSubmitViewModel
@{ViewData["Title"]="Complete Assignment";}
<div class="assignment-page assignment-submit-page"><div class="assignment-wrap"><a class="assignment-back" asp-action="Assignments">← Back to Assignments</a><section class="submit-shell"><div class="submit-illustration"><div class="assignment-eyebrow">MISSION WORKSPACE</div><h1>Complete your<br/><span>assignment.</span></h1><p>Read the teacher's instructions carefully, write your response and submit it when you're ready.</p><div class="submit-tips"><span>01 · Think</span><span>02 · Create</span><span>03 · Submit</span></div></div><form method="post" class="submit-form">@Html.AntiForgeryToken()<input type="hidden" asp-for="AssignmentId"/><label>Your response<textarea asp-for="Content" rows="16" maxlength="10000" placeholder="Write your answer here..." required></textarea><small>Up to 10,000 characters</small><span asp-validation-for="Content"></span></label><div class="assignment-form-actions"><a class="assignment-secondary" asp-action="Assignments">Save & go back</a><button class="assignment-primary" type="submit">Submit Assignment →</button></div></form></section></div></div>
