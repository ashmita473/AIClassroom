@model AIClassroom.Models.AssessmentResultViewModel
@{ViewData["Title"]="Quiz Result";}
<div class="quiz-page quiz-result-shell"><div class="quiz-wrap">
<header class="quiz-top"><a class="quiz-brand" asp-controller="Student" asp-action="Index"><img src="~/images/quiz-ui/rocket.png" alt=""/><span class="ai">AI</span> <span class="quest">QUEST</span></a><nav class="quiz-nav"><a asp-controller="Student" asp-action="Index">Home</a><a asp-controller="Curriculum" asp-action="Index">Learn</a><a asp-controller="Student" asp-action="Games">Games</a><a class="active" asp-action="Quizzes">Quizzes</a></nav><div class="quiz-user"><span class="quiz-user-avatar"></span><span class="quiz-user-name">@User.Identity?.Name</span></div></header>
<section class="result-hero"><div class="quiz-eyebrow">QUIZ COMPLETE</div><h1>@Model.Title</h1><div class="result-score">@Model.Score%</div><p>@(Model.Passed ? "Great work!" : "Keep practicing!") · Passing score @Model.PassingScore%</p><div class="result-stats"><div class="result-stat"><b>@Model.Correct</b><span>Correct</span></div><div class="result-stat"><b>@Model.Wrong</b><span>Wrong</span></div><div class="result-stat"><b>@Model.Skipped</b><span>Skipped</span></div><div class="result-stat"><b>@TimeSpan.FromSeconds(Model.TimeTakenSeconds).ToString(@"mm\:ss")</b><span>Time taken</span></div><div class="result-stat"><b>+@Model.XpEarned</b><span>XP earned</span></div></div></section>
<div class="area-grid"><div class="area-box"><h3>Strong Areas</h3><ul>@if(Model.StrongAreas.Any()){foreach(var a in Model.StrongAreas){<li>@a.Topic — @a.Accuracy%</li>}}else{<li>Keep completing quizzes to discover your strongest topics.</li>}</ul></div><div class="area-box"><h3>Needs Revision</h3><ul>@if(Model.NeedsRevision.Any()){foreach(var a in Model.NeedsRevision){<li>@a.Topic — @a.Accuracy%</li>}}else{<li>No major revision area detected yet.</li>}</ul></div></div>
<section class="area-box" style="margin-top:18px"><h3>Topic Performance</h3><div class="topic-grid">@foreach(var x in Model.TopicPerformance){<div class="topic-row"><header><strong>@x.Key</strong><b>@x.Value%</b></header><div class="topic-bar"><i style="width:@x.Value%"></i></div></div>}</div></section>
<div class="assess-actions"><a class="assess-btn" asp-action="Quizzes">Back to Quizzes</a><a class="assess-btn secondary" asp-action="Scorecard">Open Scorecard</a></div>
</div></div>
