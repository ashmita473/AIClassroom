@model List<AIClassroom.Models.Assignment>
@using AIClassroom.Models
@{ViewData["Title"]="Assignments"; var submissions=ViewBag.Submissions as Dictionary<int,Submission> ?? new();}
<div class="assignment-page student-assignment-page"><div class="assignment-wrap">
  <header class="assignment-header"><a class="assignment-brand" asp-action="Index"><span>AI</span> CLASSROOM</a><nav><a asp-action="Index">Home</a><a asp-controller="Curriculum" asp-action="Index">Learn</a><a asp-action="Games">Games</a><a asp-action="Quizzes">Quizzes</a><a asp-controller="Test" asp-action="Index">Tests</a><a class="active" asp-action="Assignments">Tasks</a><a asp-action="Notes">Notes</a></nav><div class="assignment-user"><span>★</span><img src="~/images/character/base-boy-reference-proportions.png" alt="Student avatar"/><b>@User.Identity?.Name</b></div></header>
  <section class="assignment-hero"><div class="assignment-hero-copy"><div class="assignment-eyebrow">MISSIONS FROM YOUR TEACHER</div><h1>Your next <span>mission</span> is waiting.</h1><p>Complete classroom assignments, submit your work and earn XP as you learn.</p><div class="hero-pills"><span>✓ Teacher instructions</span><span>★ Earn XP</span><span>✓ Get feedback</span></div></div><div class="assignment-hero-art"><img src="~/images/quiz-ui/take-hero.png" alt="Learning robot"/></div></section>
  @if(TempData["Result"] is string msg){<div class="assignment-alert">@msg</div>}
  <div class="assignment-section-head"><div><div class="assignment-eyebrow">YOUR MISSIONS</div><h2>Assignments</h2><p>Choose a mission, complete it and submit your answer before the deadline.</p></div><div class="assignment-filter-count">@Model.Count available</div></div>
  <div class="student-assignment-grid">
  @foreach(var a in Model){
    var sub=submissions.TryGetValue(a.Id,out var ss)?ss:null; var overdue=a.DueDateUtc.HasValue&&a.DueDateUtc.Value<DateTime.UtcNow&&!submissions.ContainsKey(a.Id); var status=sub!=null?(sub.Marks.HasValue?"Graded":"Submitted"):(overdue?"Overdue":"Not started");
    <article class="student-assignment-card @(status.ToLowerInvariant().Replace(" ","-"))"><div class="student-card-top"><span class="assignment-badge">GROUP @a.GroupName</span><span class="assignment-status @status.ToLowerInvariant().Replace(" ","-")">@status</span></div><h3>@a.Title</h3><p>@a.Instructions</p><div class="student-assignment-meta"><span>★ +@a.XpReward XP</span><span>⏱ @(a.DueDateUtc.HasValue?a.DueDateUtc.Value.ToLocalTime().ToString("dd MMM yyyy · hh:mm tt"):"No due date")</span></div>@if(sub?.Marks.HasValue==true){<div class="returned-feedback"><strong>@sub.Marks/100</strong><span>@(string.IsNullOrWhiteSpace(sub.Feedback)?"Teacher has graded your work.":sub.Feedback)</span></div>}<div class="student-card-actions">@if(sub==null){<a class="assignment-primary" asp-action="SubmitAssignment" asp-route-id="@a.Id">Open Mission →</a>}else{<span class="submitted-note">✓ Submitted · XP earned</span>}</div></article>
  }
  @if(!Model.Any()){<div class="assignment-empty"><div class="assignment-empty-icon">✦</div><h3>No missions yet</h3><p>Your teacher will publish assignments here.</p></div>}
  </div>
</div></div>
