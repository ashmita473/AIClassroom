@model List<AIClassroom.Models.Assignment>
@{ViewData["Title"]="Assignments";}<div class="page-title"><div><div class="eyebrow">MISSIONS FROM TEACHER</div><h1>📚 Assignments</h1></div></div><div class="quiz-list">@foreach(var a in Model){<article class="panel pixel"><h2>@a.Title</h2><p>@a.Instructions</p><small>Due: @(a.DueDateUtc?.ToLocalTime().ToString("dd MMM yyyy") ?? "No due date") · +@a.XpReward XP</small><br/><a class="big-btn primary" asp-action="SubmitAssignment" asp-route-id="@a.Id">Submit →</a></article>}</div>
