@model List<AIClassroom.Models.StudentNote>
@{ViewData["Title"]="My Notes";}<div class="page-title"><div><div class="eyebrow">MY LEARNING LOG</div><h1>📝 Notes</h1></div><a class="big-btn primary" asp-action="NewNote">+ New Note</a></div><div class="note-grid">@foreach(var n in Model){<article class="note pixel">@if(n.IsPinned){<span class="pin">📌</span>}<h2>@n.Title</h2><p>@n.Content</p><form method="post" asp-action="DeleteNote"><input type="hidden" name="id" value="@n.Id"/><button class="danger-btn">Delete</button></form></article>}@if(!Model.Any()){<div class="empty pixel">No notes yet. Start your first learning note!</div>}</div>
