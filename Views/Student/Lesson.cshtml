@model AIClassroom.Models.CurriculumDay
@{ViewData["Title"]=$"Day {Model.DayNumber}";}
<div class="lesson-head"><div><div class="eyebrow">@Model.Module!.GroupName · @Model.Module.Code · DAY @Model.DayNumber</div><h1>@Model.Title</h1><p class="muted">+@Model.XpReward XP mission</p></div><div class="float-robot">🤖</div></div>
@if(Model.Lesson is not null){<div class="lesson-grid"><article class="lesson-content pixel"><div class="lesson-section"><h2>🌟 Introduction</h2><p>@Model.Lesson.Introduction</p></div><div class="lesson-section"><h2>🧠 Learn</h2><p>@Model.Lesson.Explanation</p></div><div class="lesson-section"><h2>🔎 Examples</h2><p>@Model.Lesson.Examples</p></div><div class="lesson-section"><h2>🎮 Activities</h2>@foreach(var a in Model.Lesson.Activities.OrderBy(x=>x.SortOrder)){<div class="activity"><span>@a.ActivityType</span><h3>@a.Title</h3><p>@a.Content</p><b>+@a.XpReward XP</b></div>}</div><form method="post" asp-controller="Student" asp-action="CompleteLesson"><input type="hidden" name="id" value="@Model.Id"/><button class="big-btn primary full">✅ COMPLETE MISSION +@Model.XpReward XP</button></form></article><aside class="panel pixel"><h2>📝 My Mission Notes</h2><p class="muted">Write what you learned.</p><a class="big-btn" asp-controller="Student" asp-action="NewNote" asp-route-dayId="@Model.Id">+ Create Note</a><h3>Teacher Focus</h3><p>@Model.Lesson.TeacherNotes</p></aside></div>}
