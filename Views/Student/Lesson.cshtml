@model AIClassroom.Models.CurriculumDay
@{ViewData["Title"]=$"Lesson {Model.DayNumber}"; var completedVideos=ViewBag.CompletedVideoIds as HashSet<int> ?? new HashSet<int>();}
<div class="lesson-page-reference student-lesson-video-page">
<header class="lesson-ref-header"><a class="lesson-ref-brand" asp-controller="Student" asp-action="Index"><span>AI</span> CLASSROOM</a><nav><a asp-controller="Student" asp-action="Index">⌂ Home</a><a asp-controller="Curriculum" asp-action="Index" class="active">▣ Learn</a><a asp-controller="Student" asp-action="Games">🎮 Games</a><a asp-controller="Student" asp-action="Quizzes">🏆 Quizzes</a><a asp-controller="Test" asp-action="Index">▤ Tests</a></nav><div class="lesson-ref-user"><span>@User.Identity?.Name</span><a asp-controller="Account" asp-action="Logout">⌄</a></div></header>
<div class="lesson-ref-title"><div><div class="eyebrow">@Model.Module!.GroupName · @Model.Module.Code · LESSON @Model.DayNumber</div><h1>@Model.Title</h1><p>+@Model.XpReward XP mission</p></div><div class="lesson-ref-robot">🤖</div></div>
@if(TempData["LessonVideoRequired"] is string msg){<div class="lesson-video-alert">@msg</div>}
@if(Model.Lesson is null){<section class="lesson-empty-ref"><h2>Your lesson is being prepared.</h2><p>Your teacher has not added the lesson content yet.</p></section>}else{
<div class="lesson-ref-grid"><main>
<section class="lesson-ref-banner"><div class="lesson-ref-icon">💡</div><div><h2>Introduction</h2><div>@Html.Raw(Model.Lesson.Introduction)</div></div></section>
<section class="lesson-ref-banner"><div class="lesson-ref-icon brain">🧠</div><div><h2>Learn</h2><div>@Html.Raw(Model.Lesson.Explanation)</div></div></section>
<section class="lesson-ref-banner"><div class="lesson-ref-icon search">🔎</div><div><h2>Examples</h2><div>@Html.Raw(Model.Lesson.Examples)</div></div></section>
@if(Model.Lesson.Videos.Any(v=>v.IsPublished)){<section class="lesson-video-section"><div class="lesson-video-section-head"><div><div class="eyebrow">WATCH & LEARN</div><h2>Lesson Videos</h2><p>Watch the videos without leaving AI Classroom. Required videos are marked below.</p></div><span class="lesson-video-count">@Model.Lesson.Videos.Count(v=>v.IsPublished) videos</span></div><div class="lesson-video-list">@foreach(var v in Model.Lesson.Videos.Where(x=>x.IsPublished).OrderBy(x=>x.SortOrder)){var watched=completedVideos.Contains(v.Id);<article class="lesson-video-card @(watched?"is-complete":"")" data-video-card data-video-id="@v.Id" data-youtube-id="@v.YouTubeVideoId"><div class="lesson-video-meta"><span class="lesson-video-number">VIDEO @v.SortOrder</span>@if(v.IsRequired){<span class="lesson-video-required">REQUIRED</span>}<span class="lesson-video-xp">+@v.XpReward XP</span></div><h3>@v.Title</h3>@if(!string.IsNullOrWhiteSpace(v.Description)){<p>@v.Description</p>}<div class="lesson-video-player"><iframe src="https://www.youtube.com/embed/@v.YouTubeVideoId?enablejsapi=1&rel=0&playsinline=1" title="@v.Title" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe></div><div class="lesson-video-status" data-video-status>@(watched ? $"✓ Watched · +{v.XpReward} XP earned" : "▶ Play the video. XP is awarded when the video finishes.")</div></article>}}</div></section>}
<section class="lesson-ref-activities"><h2>🎮 Activities</h2>@foreach(var a in Model.Lesson.Activities.OrderBy(x=>x.SortOrder)){<article><span>@a.ActivityType</span><div><h3>@a.Title</h3><div>@Html.Raw(a.Content)</div></div><b>+@a.XpReward XP</b></article>}</section>
<form method="post" asp-controller="Student" asp-action="CompleteLesson" class="lesson-complete-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><button type="submit">✓ COMPLETE MISSION +@Model.XpReward XP</button></form>
</main><aside class="lesson-ref-side"><section><h2>📝 My Mission Notes</h2><p>Write what you learned.</p><a asp-controller="Student" asp-action="NewNote" asp-route-dayId="@Model.Id">+ Create Note</a></section><section><h2>🎓 Teacher Focus</h2><div>@Html.Raw(Model.Lesson.TeacherNotes)</div></section><section><h2>📌 Student Notes</h2><div>@Html.Raw(Model.Lesson.StudentNotesTemplate)</div></section></aside></div>}
</div>
@section Scripts{<script src="~/js/lesson-videos.js" asp-append-version="true"></script>}
