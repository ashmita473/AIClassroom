@model AIClassroom.Models.AssessmentResultViewModel
@{ViewData["Title"]="Test Result";}
<div class="assess-shell"><div class="assess-wrap">
<header class="assess-top"><a class="assess-brand" asp-controller="Student" asp-action="Index"><span>AI</span> CLASSROOM</a><nav class="assess-nav"><a asp-controller="Student" asp-action="Quizzes">Quizzes</a><a asp-action="Index" class="active">Tests</a></nav></header>
<section class="result-hero @(Model.Passed?"pass":"fail")"><div class="assess-eyebrow">TEST COMPLETE</div><h1>@Model.Title</h1><div class="result-score">@Model.Score%</div><p>@(Model.Passed ? "Passed" : "Needs more revision") · Passing score @Model.PassingScore%</p><div class="result-stats"><div class="result-stat"><b>@Model.Correct</b><span>Correct</span></div><div class="result-stat"><b>@Model.Wrong</b><span>Wrong</span></div><div class="result-stat"><b>@Model.Skipped</b><span>Skipped</span></div><div class="result-stat"><b>@TimeSpan.FromSeconds(Model.TimeTakenSeconds).ToString(@"mm\:ss")</b><span>Time taken</span></div><div class="result-stat"><b>+@Model.XpEarned</b><span>XP earned</span></div></div></section>
<div class="area-grid"><div class="area-box"><h3>Strong Areas</h3><ul>@if(Model.StrongAreas.Any()){foreach(var a in Model.StrongAreas){<li>@a.Topic — @a.Accuracy%</li>}}else{<li>Keep practicing to build strong areas.</li>}</ul></div><div class="area-box"><h3>Needs Revision</h3><ul>@if(Model.NeedsRevision.Any()){foreach(var a in Model.NeedsRevision){<li>@a.Topic — @a.Accuracy%</li>}}else{<li>No major revision area detected yet.</li>}</ul></div></div>
<section class="assess-card" style="margin-top:18px"><h2>Topic Performance</h2><div class="topic-grid">@foreach(var x in Model.TopicPerformance){<div class="topic-row"><header><strong>@x.Key</strong><b>@x.Value%</b></header><div class="topic-bar"><i style="width:@x.Value%"></i></div></div>}</div></section>
<div class="assess-actions" style="margin-top:18px"><a class="assess-btn" asp-action="Index">Back to Tests</a><a class="assess-btn secondary" asp-controller="Student" asp-action="Scorecard">Open Scorecard</a></div>
</div></div>
