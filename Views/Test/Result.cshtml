@model AIClassroom.Models.AssessmentResultViewModel
@{ViewData["Title"]="Test Result";}
<div class="assess-shell">
 <div class="assess-wrap">
  <header class="assess-top"><a class="assess-brand" asp-controller="Student" asp-action="Index"><span class="brand-ai">AI</span> CLASSROOM</a><nav class="assess-nav"><a asp-controller="Student" asp-action="Index"><img src="~/images/ui/home.svg" alt="">Home</a><a asp-controller="Curriculum" asp-action="Index"><img src="~/images/ui/book.svg" alt="">Learn</a><a asp-controller="Student" asp-action="Games"><img src="~/images/ui/game.svg" alt="">Games</a><a asp-controller="Student" asp-action="Quizzes"><img src="~/images/ui/quiz.svg" alt="">Quizzes</a><a asp-action="Index" class="active"><img src="~/images/home/tests.png" alt="">Tests</a></nav><div class="assess-user"><img src="~/images/character/base-boy-reference-proportions.png" alt=""> <span>@User.Identity?.Name</span><span>⌄</span></div></header>
  <section class="result-hero @(Model.Passed?"pass":"fail")"><img class="result-robot" src="~/images/quiz-ui/quiz-hero-robot.png" alt="Celebrating learning robot"><div class="result-copy"><div class="assess-eyebrow">TEST COMPLETE</div><h1>@Model.Title</h1><div class="result-score">@Model.Score%</div><p>@(Model.Passed ? "Passed" : "Needs more revision") · Passing score @Model.PassingScore%</p></div><img class="result-star-art" src="~/images/ui/star.svg" alt=""></section>
  <div class="result-stats"><div class="result-stat"><span class="stat-icon green">✓</span><b>@Model.Correct</b><span>Correct</span></div><div class="result-stat"><span class="stat-icon red">×</span><b>@Model.Wrong</b><span>Wrong</span></div><div class="result-stat"><span class="stat-icon gold">▶</span><b>@Model.Skipped</b><span>Skipped</span></div><div class="result-stat"><span class="stat-icon purple">◷</span><b>@TimeSpan.FromSeconds(Model.TimeTakenSeconds).ToString(@"mm\:ss")</b><span>Time taken</span></div><div class="result-stat"><span class="stat-icon blue">★</span><b>+@Model.XpEarned</b><span>XP earned</span></div></div>
  <div class="area-grid"><div class="area-box strong"><span class="area-icon">▥</span><div><h3>Strong Areas</h3><ul>@if(Model.StrongAreas.Any()){foreach(var a in Model.StrongAreas){<li>@a.Topic — @a.Accuracy%</li>}}else{<li>Keep practicing to build strong areas.</li>}</ul></div></div><div class="area-box revision"><span class="area-icon">◎</span><div><h3>Needs Revision</h3><ul>@if(Model.NeedsRevision.Any()){foreach(var a in Model.NeedsRevision){<li>@a.Topic — @a.Accuracy%</li>}}else{<li>No major revision area detected yet.</li>}</ul></div></div></div>
  <section class="assess-card topic-card"><h2>Topic Performance</h2><div class="topic-grid">@foreach(var x in Model.TopicPerformance){<div class="topic-row"><header><strong>@x.Key</strong><b>@x.Value%</b></header><div class="topic-bar"><i style="width:@x.Value%"></i></div></div>}</div></section>
  <div class="assess-actions"><a class="assess-btn" asp-action="Index">← Back to Tests</a><a class="assess-btn secondary" asp-controller="Student" asp-action="Scorecard">▥ Open Scorecard</a></div>
 </div>
</div>
